<?xml version="1.0" encoding="UTF-8"?>
<!--
  ILLUSTRATIVE EXAMPLE — not the real Springboard release asset.

  Embedded JVM runtime entitlements for DIRECT distribution. Compose Multiplatform
  signs the bundled Java runtime separately from the app bundle; these are the
  hardened-runtime exceptions the runtime needs. Non-sandboxed, no
  application-identifier (direct path only).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
